# Copy to .env (never committed) and replace every value:
#   Copy-Item .env.example .env
# Docker Compose, the e2e tests, the k6 runner and the query benchmark all read .env.

# MySQL: app user (DB_PASSWORD) and root (MYSQL_ROOT_PASSWORD; only the benchmark script uses it).
# Both are applied when the MySQL volume is first created. To change them later, ALTER USER or `docker compose down -v`.
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# RabbitMQ user "scalecart" (set when the RabbitMQ volume is first created). Letters and digits only:
# it is also embedded in the amqp:// URL.
RABBITMQ_PASSWORD=changemerabbitpassword

# Signs access tokens. At least 32 random characters.
# PowerShell: -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
JWT_SECRET=change-me-at-least-32-random-characters-long

# Admin account created by the seed script (admin@scalecart.local). 10+ characters.
ADMIN_PASSWORD=change-me-admin-password

# Shared password of the fake load-test users loadtest+1..N@scalecart.local.
SEED_USER_PASSWORD=loadtest-password

# AI shopping assistant (optional): a Google AI Studio key (https://aistudio.google.com/apikey).
# Server-side only, never sent to the browser. Empty = the assistant is off.
# Free tier: Google may use the prompts to improve its products, so never send real customer data.
GEMINI_API_KEY=
# AI_MODEL=gemini-3.6-flash
# AI_THINKING_LEVEL=minimal

# Payments (optional): Razorpay TEST mode keys (dashboard.razorpay.com → Test Mode → API Keys).
# Empty = payments off. The key id is public (the browser gets it); the two secrets stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string; paste the same value into the dashboard's webhook settings.
RAZORPAY_WEBHOOK_SECRET=
# PAYMENT_TIMEOUT_SECONDS=900
# Your free fixed ngrok address (dashboard.ngrok.com → Domains), used by infra/tunnel.ps1.
# Dashboard webhook URL, set once: https://<NGROK_DOMAIN>/payments/razorpay/webhook
NGROK_DOMAIN=
